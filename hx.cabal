cabal-version:      3.8
name:               hx
version:            0.1.0
synopsis:           Haskell-first toolchain helper
description:
    hx is a Cabal-first command plane for Haskell project lifecycle work. It
    starts with init, dependency changes, run/test/doctor/ci, and AI-readable
    operation plans on top of cabal, ghc, ghcup, pkg-config, and modern linkers.
license:            MIT
license-file:       LICENSE
author:             Masaya
maintainer:         Masaya
category:           Development
build-type:         Simple
extra-source-files:
    README.md
    AGENTS.md
    CHANGELOG.md
    CONTRIBUTING.md
    MAINTAINERS.md
    SECURITY.md
    STATUS.md
    .github/ISSUE_TEMPLATE/bug-report.md
    .github/ISSUE_TEMPLATE/config.yml
    .github/pull_request_template.md
    .github/workflows/ci.yml
    .github/workflows/pages.yml
    docs/architecture.md
    docs/known-limitations.md
    docs/release-process.md
    docs/releases/README.md
    docs/releases/v0.1.0-pre.1.md
    docs/vision.md
    docs/roadmap.md
    docs/release-checklist.md
    docs/release-notes-template.md
    scripts/public-audit.sh
    scripts/public-ci.sh
    scripts/public-export.sh
    scripts/create-release-draft.sh
    scripts/release-preflight.sh
    scripts/release-sdist-check.sh
    site/index.html
    site/styles.css

common shared-options
    ghc-options: -Wall
    default-language: GHC2021

executable hx
    import: shared-options
    main-is: Main.hs
    hs-source-dirs:
        app
        src
    autogen-modules:
        Paths_hx
    other-modules:
        Hx.Command.Add
        Hx.Command.Build
        Hx.Command.CabalSupport
        Hx.Command.Ci
        Hx.CLI
        Hx.Command.Doctor
        Hx.Command.Init
        Hx.Command.Run
        Hx.Command.Status
        Hx.Json
        Hx.Project
        Paths_hx
    build-depends:
        base >=4.18 && <4.22
      , directory >=1.3 && <1.4
      , filepath >=1.4 && <1.6
      , process >=1.6 && <1.7

test-suite hx-smoke
    import: shared-options
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs:
        test
        src
    autogen-modules:
        Paths_hx
    other-modules:
        Hx.Command.Add
        Hx.Command.Build
        Hx.Command.CabalSupport
        Hx.Command.Ci
        Hx.CLI
        Hx.Command.Doctor
        Hx.Command.Init
        Hx.Command.Run
        Hx.Command.Status
        Hx.Json
        Hx.Project
        Paths_hx
    build-depends:
        base >=4.18 && <4.22
      , directory >=1.3 && <1.4
      , filepath >=1.4 && <1.6
      , process >=1.6 && <1.7
